<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Header & App Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIFEOS"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • MUSIC"
            android:textColor="#88FFFFFF"
            android:textSize="11sp"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Track Info Row: Album Art + Titles -->
    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp">

        <!-- Album Artwork Preview -->
        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_art_bg"
            android:src="@drawable/ic_music_play"
            android:scaleType="centerCrop"
            android:contentDescription="Album Art" />

        <!-- Title & Artist -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No track playing"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tap to open LifeOS"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Playback Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Prev -->
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_music_prev"
            android:contentDescription="Previous track"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <!-- Play/Pause -->
        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_music_play"
            android:contentDescription="Play/Pause"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <!-- Next -->
        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_music_next"
            android:contentDescription="Next track"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </LinearLayout>

</LinearLayout>
